{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "fed-node-npm-template": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "polyfills": [
              "src/polyfills.ts"
            ],
            "outputPath": {
              "base": "dist",
              "browser": ""
            },
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "output": "assets",
                "ignore": [
                  "config/**"
                ]
              }
            ],
            "styles": [
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "scripts": [
                "mocks/serve/native/storage.js",
                "mocks/serve/native/login.js",
                "mocks/serve/native/remote-config.js",
                "mocks/serve/native/security-key.js",
                "mocks/serve/native/threat.js",
                "mocks/serve/native/tracking.js",
                "mocks/serve/native/ui.js",
                "mocks/serve/native/virtual-id.js",
                "mocks/serve/native/gps.js",
                "mocks/serve/native/bnc.js"
              ],
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public",
                  "output": "/assets/"
                }
              ],
              "index": "mocks/_index.html"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "fed-node-npm-template:build:production"
            },
            "development": {
              "buildTarget": "fed-node-npm-template:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runnerConfig": "vitest.config.ts"
          }
        }
      }
    }
  }
}